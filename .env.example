[TEMPLATE]
# Base de données
# Développement local (SQLite) :
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) :
# DATABASE_URL="postgresql://user:password@localhost:5432/santeplus"

# Sécurité — OBLIGATOIRE à changer en production (64+ caractères aléatoires)
JWT_SECRET="change-me-in-production"

# Clé de chiffrement des données sensibles (nationalId, motif médical, diagnostic)
# INDÉPENDANTE du JWT_SECRET — si elle change, les données chiffrées sont perdues !
# OBLIGATOIRE en production (démarrage refusé sinon) ; optionnelle en dev (fallback dérivé du JWT).
# Les payload chiffrés sont versionnés « v1. » (clé dédiée) ; les payload legacy restent lisibles.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=""

PORT=4000

# Origine(s) autorisée(s) pour le CORS, séparées par des virgules
WEB_ORIGIN="http://localhost:3000"

# URL publique de l API (callbacks de paiement PSP : /api/payments/webhook/...).
# Les liens d email qui visent le FRONT (/app/..., /reinitialiser-mot-de-passe)
# sont construits sur WEB_ORIGIN, pas sur cette variable : si le front est
# hébergé ailleurs que l API, un lien bâti sur APP_URL finit en 404.
APP_URL="http://localhost:3000"

# Paiements
# MOCK_PAYMENTS=true autorise POST /api/payments/mock/confirm (jamais en production).
# Production PSP réel : MOCK_PAYMENTS=false et PAY_PROVIDERS=CINETPAY,FEDAPAY
MOCK_PAYMENTS="true"
PAY_PROVIDERS="MOCK_MOMO"

# FedaPay (https://fedapay.com) — activer en ajoutant le code FEDAPAY à PAY_PROVIDERS
# Callback à déclarer chez le PSP : {APP_URL}/api/payments/webhook/fedapay
# FEDAPAY_MODE=sandbox (défaut) ou live. Vérifier l'unité du champ amount sur le
# sandbox (XOF entier vs centimes) avant le passage en live.
FEDAPAY_SECRET_KEY=""
FEDAPAY_MODE="sandbox"

# CinetPay (https://cinetpay.com) — MTN MoMo / Moov Money ; code CINETPAY
# Notify URL à déclarer chez le PSP : {APP_URL}/api/payments/webhook/cinetpay
# Le succès est toujours re-vérifié via /v2/payment/check (montant inclus) —
# le webhook seul ne confirme jamais un paiement.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Notifications multi-canaux (§13)
# Sujets éligibles à chaque canal (liste séparée par des virgules) — "none" pour désactiver :
NOTIFY_EMAIL_TOPICS=""
NOTIFY_SMS_TOPICS=""
# Sans configuration, les envois sont journalisés dans la console (mode démo).
# E-mail transactionnel via Resend — charge utile {from, to:[...], subject, text, html},
# en-tête Authorization: Bearer. C est ce format que le code envoie : Brevo et
# SendGrid attendent d autres clés, changer EMAIL_API_URL seul ne suffirait pas.
# EMAIL_API_URL="https://api.resend.com/emails"
# EMAIL_API_KEY="re_..."
# EMAIL_FROM="SantéPlus <no-reply@votre-domaine>"   (expéditeur vérifié chez Resend)
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@santeplus.bj"
# SMS via passerelle HTTP générique :
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="SantePlus"
# WhatsApp Business Cloud API (Meta) — prioritaire sur le SMS si configuré :
WA_TOKEN=""
WA_PHONE_ID=""

# Seuil global de secours pour l'autorisation préalable tiers-payant (I1) :
# éditable aussi via SystemConfig `thirdPartyAuthGlobalFallback` (admin), qui prime.
THIRD_PARTY_AUTH_GLOBAL_FALLBACK="150000"

NODE_ENV="development"

# Sonde de version (GET /api/version) — comparée au SHA publié par le
# health-check de deploy.yml pour détecter un déploiement périmé.
# En Docker, le Dockerfile tamponne dist/build-info.json (APP_VERSION = SHA
# transmis par la CI via --build-arg, builtAt = date du build) ; ces variables
# restent prioritaires comme échappatoire quand le runtime ne peut pas
# reconstruire l'image (ex. plateforme qui recycle une image existante).
APP_VERSION=""
BUILT_AT=""

# =============================================================================
# DÉPLOIEMENT GRATUIT — Supabase (Postgres) / Vercel (front) / Cloudflare R2
# =============================================================================
# Supabase (Dashboard > Project Settings > Database > Connection string) :
#  - hôte Node longue durée (API NestJS) : direct 5432 ou session pooler 5432
#  - serverless : pooler transactionnel pgBouncer port 6543
# DATABASE_URL="postgresql://postgres.<ref>:<motdepasse>@aws-0-<zone>.pooler.supabase.com:5432/postgres"

# Cloudflare R2 est S3-compatible : le module files utilise déjà @aws-sdk/client-s3.
# Renseigner ces variables pour stocker les fichiers sur R2 (sinon disque local) :
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="santeplus-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Front sur Vercel (Settings > Environment Variables) :
# VITE_API_URL="https://<url-de-l-api>"   (aussi dans apps/web/vercel.json > rewrites)
