generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String?
  passwordHash     String
  role             String
  status           String        @default("ACTIVE")
  firstName        String
  lastName         String
  birthDate        DateTime?
  gender           String?
  address          String?
  city             String?
  nationalIdEnc    String?
  emergencyContact String?
  memberNumber     String?       @unique
  photoFileId      String?
  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id])
  providerId       String?
  providerStaff    Provider?     @relation(fields: [providerId], references: [id])
  isEstablishmentAdmin Boolean @default(false)
  language         String        @default("fr")
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  referredBy           Distributor?    @relation("ReferredUsers", fields: [referredById], references: [id])
  referredById         String?
  contractsAsPrincipal Contract[]       @relation("PrincipalContracts")
  beneficiariesAdded   Beneficiary[]    @relation("BeneficiaryCreator")
  beneficiaryChanges   BeneficiaryChange[]
  files                FileObject[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  payments             Payment[]
  claims               Claim[]          @relation("Claimant")
  consultations        Consultation[]   @relation("ConsultationPatient")
  prescriptions        Prescription[]   @relation("PrescriptionPatient")
  prescriptionsWritten Prescription[]   @relation("PrescriptionPrescriber")
  deliveries           Delivery[]       @relation("DeliveryUser")
  deliveriesAsPatient  Delivery[]       @relation("DeliveryPatient")
  claimsDecided        Claim[]          @relation("ClaimDecider")
  refreshTokens        RefreshToken[]
  careRecords          CareRecord[]     @relation("CareRecordPatient")
  distributorProfile   Distributor?     @relation("DistributorUser")
  consentGivenAt DateTime?
  consentIp      String?

  @@index([role])
  @@index([status])
  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String?
  taxId       String?
  address     String?
  city        String?
  phone       String?
  email       String?
  contactName String?
  status      String   @default("ACTIVE")
  claimsVisibility Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees User[]
  contracts Contract[]

  @@index([status])
}

model InsurerPartner {
  id              String  @id @default(cuid())
  name            String
  kind            String  @default("INSURER")
  agreementNumber String?
  contactEmail    String?
  phone           String?
  status          String  @default("ACTIVE")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products  Product[]
  contracts Contract[]
}

model Guarantee {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  category  String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  // Prix de base annuel pour cette garantie (taux 100%, plafond de référence)
  basePrice Int     @default(0)

  productGuarantees ProductGuarantee[]
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  clientType  String   @default("INDIVIDUAL")
  minAge      Int      @default(0)
  maxAge      Int      @default(65)
  beneficiaryRules     String @default("{}")
  basePremiumAnnual           Int
  pricePerAdditionalAdultAnnual Int @default(0)
  pricePerChildAnnual           Int @default(0)
  frequencyFactors     String @default("{\"ANNUAL\":1,\"QUARTERLY\":1.03,\"MONTHLY\":1.08}")
  waitingPeriodDays    Int    @default(30)
  eligibilityConditions String?
  renewalConditions     String?
  ageLoadings     String @default("[]")
  globalAnnualCap Int    @default(5000000)
  status      String   @default("DRAFT")
  sortOrder   Int      @default(0)
  thirdPartyAuthThreshold Int?
  insurerPartnerId String?
  insurerPartner   InsurerPartner? @relation(fields: [insurerPartnerId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guarantees ProductGuarantee[]
  exclusions ProductExclusion[]
  contracts  Contract[]

  @@index([clientType, status])
}

model ProductGuarantee {
  id              String  @id @default(cuid())
  productId       String
  guaranteeId     String
  // Plafond annuel fixe (si null, calculé dynamiquement)
  annualLimit     Int?
  // Taux de couverture fixe (si null, choisi par l'assuré entre minRate et maxRate)
  rate            Int?
  // Taux minimum autorisé pour cette garantie (flexible)
  minRate         Int     @default(50)
  // Taux maximum autorisé pour cette garantie (flexible)
  maxRate         Int     @default(95)
  // Plafond minimum autorisé
  minLimit        Int     @default(0)
  // Plafond maximum autorisé
  maxLimit        Int     @default(10000000)
  // Pas d'incrémentation pour le plafond (ex: 50000)
  limitStep       Int     @default(50000)
  // Prix de base par tranche de plafond (pour calcul de prime flexible)
  pricePerLimitStep Int   @default(0)
  deductibleType  String  @default("NONE")
  deductibleValue Int     @default(0)
  copayRate       Int     @default(15)
  maxUnitPrice    Int?
  // Si true, cette garantie est obligatoire pour le produit
  mandatory       Boolean @default(true)
  // Si true, l'assuré peut personnaliser le taux/plafond
  customizable    Boolean @default(false)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  guarantee Guarantee @relation(fields: [guaranteeId], references: [id])

  @@unique([productId, guaranteeId])
}

model ProductExclusion {
  id          String  @id @default(cuid())
  productId   String
  categoryId  String?
  description String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Contract {
  id       String @id @default(cuid())
  number   String @unique
  kind     String @default("INDIVIDUAL")
  status   String @default("DRAFT")
  principalUserId String
  principalUser   User   @relation("PrincipalContracts", fields: [principalUserId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  groupContractId String?
  groupContract   Contract?  @relation("GroupMembers", fields: [groupContractId], references: [id])
  members         Contract[] @relation("GroupMembers")
  insurerPartnerId String?
  insurerPartner   InsurerPartner? @relation(fields: [insurerPartnerId], references: [id])

  startDate DateTime?
  endDate   DateTime?
  premiumAnnual Int
  frequency String
  quote     String   @default("{}")
  cardToken String   @unique
  adhesionFee     Int       @default(0)
  adhesionPaidAt  DateTime?

  beneficiaries Beneficiary[]
  contributions Contribution[]
  claims        Claim[]
  payments      Payment[]
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  commissions   Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([principalUserId])
  @@index([companyId])
  @@index([groupContractId])
}

model Beneficiary {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id])
  addedById    String?
  addedBy      User?     @relation("BeneficiaryCreator", fields: [addedById], references: [id])
  firstName    String
  lastName     String
  birthDate    DateTime
  gender       String
  relation     String
  memberNumber String    @unique
  photoFileId  String?
  status       String    @default("COVERED")
  removedAt    DateTime?

  changes BeneficiaryChange[]
  claims  Claim[]
  careRecords CareRecord[]

  @@index([contractId])
}

model BeneficiaryChange {
  id            String   @id @default(cuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  action        String
  meta          String?
  byUserId      String?
  byUser        User?    @relation(fields: [byUserId], references: [id])
  createdAt     DateTime @default(now())

  @@index([beneficiaryId])
}

model Contribution {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id])
  sequence   Int
  dueDate    DateTime
  amount     Int
  status     String    @default("PENDING")
  paidAt     DateTime?
  paymentId  String?

  @@unique([contractId, sequence])
  @@index([status, dueDate])
}

model Payment {
  id          String    @id @default(cuid())
  reference   String    @unique
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Int
  method      String
  status      String    @default("PENDING")
  externalRef String?
  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  meta        String?

  @@index([status])
  @@index([userId])
}

model Claim {
  id             String    @id @default(cuid())
  reference      String    @unique
  kind           String    @default("REIMBURSEMENT")
  contractId     String
  contract       Contract  @relation(fields: [contractId], references: [id])
  claimantUserId String
  claimantUser   User      @relation("Claimant", fields: [claimantUserId], references: [id])
  beneficiaryId  String?
  beneficiary    Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id])
  providerUserId String?
  careDate       DateTime
  submittedAt    DateTime?
  status         String    @default("DRAFT")
  totalRequested Int       @default(0)
  totalApproved  Int?
  decisionNote   String?
  decidedById    String?
  decidedBy      User?     @relation("ClaimDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  paidAt         DateTime?
  paidRef        String?
  invoiceNumber  String?
  invoicedAt     DateTime?
  realizationNote String?
  estimation     String?
  flags          String    @default("[]")
  emergencyOverride      Boolean   @default(false)
  emergencyJustification String?
  emergencyActorId       String?
  emergencyAt            DateTime?
  authorizedAmount       Int?
  diseaseId String?
  disease   Disease? @relation(fields: [diseaseId], references: [id])

  items     ClaimItem[]
  documents ClaimDocument[]
  consultation  Consultation? @relation("ConsultationClaim")
  delivery      Delivery?     @relation("DeliveryClaim")
  prescription  Prescription? @relation("ClaimPrescription", fields: [prescriptionId], references: [id])
  prescriptionId String?
  deliveryId     String?
  careRecord     CareRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([claimantUserId])
  @@index([contractId])
  @@index([kind, status])
  @@index([diseaseId])
}

model ClaimItem {
  id               String  @id @default(cuid())
  claimId          String
  claim            Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actId            String?
  code             String?
  label            String?
  quantity         Int?
  unitPrice        Int?
  practitioner     String?
  guaranteeId      String?
  categoryLabel    String
  amountRequested  Int
  amountEligible   Int?
  rateApplied      Int?
  deductibleApplied Int?
  amountApproved   Int?
}

model ClaimDocument {
  id         String  @id @default(cuid())
  claimId    String
  claim      Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject @relation(fields: [fileId], references: [id])
  docType    String
  fileName   String
  mime       String
  size       Int
  sha256     String
  extracted  String?

  @@index([sha256])
}

model FileObject {
  id          String   @id @default(cuid())
  storagePath String   @unique
  mime        String
  size        Int
  sha256      String
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  documentType String?
  tags         String? @default("[]")
  version      Int     @default(1)
  previousVersionId String?
  createdAt   DateTime @default(now())

  claimDocs ClaimDocument[]

  @@index([ownerId])
  @@index([documentType])
}

model Provider {
  id              String  @id @default(cuid())
  name            String
  type            String
  city            String
  address         String?
  phone           String?
  email           String?
  lat             Float?
  lng             Float?
  specialties     String?
  openingHours    String?
  services        String?
  partnerStatus   String  @default("ACTIVE")
  conventionLevel String  @default("BASIC")
  thirdPartyPayer Boolean @default(false)
  status          String  @default("ACTIVE")
  notes           String?
  active          Boolean @default(true)
  photoUrl        String?
  // Champs inscription publique
  registrationStatus String @default("")  // PENDING_REGISTRATION, DOCUMENTS_REVIEWED, APPROVED, REJECTED
  registrationNote   String?
  contactFirstName  String?
  contactLastName   String?
  contactEmail      String?
  contactPhone      String?
  registrationDocs  String  @default("[]")  // JSON array of uploaded doc refs
  createdAt       DateTime @default(now())

  staff  User[]
  claims Claim[]
  consultations Consultation[]
  prescriptions Prescription[] @relation("PrescriptionProvider")
  deliveries Delivery[]
  careRecords CareRecord[]

  @@index([city])
  @@index([type])
}

model Act {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  categoryId     String
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id])
  referencePrice Int
  requiresPrescription Boolean @default(false)
  requiresPriorAuth    Boolean @default(false)
  authThreshold  Int?
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
  @@index([branchId])
  @@index([active])
}

model Medication {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  dci            String?
  dosage         String?
  form           String?
  price          Int
  requiresPrescription Boolean @default(true)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescriptionLines PrescriptionLine[]
  deliveryLines     DeliveryLine[]

  @@index([active])
}

model Consultation {
  id                String   @id @default(cuid())
  reference         String   @unique
  patientUserId     String
  patientUser       User     @relation("ConsultationPatient", fields: [patientUserId], references: [id])
  beneficiaryId     String?
  providerId        String
  provider          Provider @relation(fields: [providerId], references: [id])
  practitionerUserId String?
  practitionerName  String
  specialty         String?
  motif             String
  motifEnc          String?
  diagnostic        String?
  diagnosticEnc     String?
  careDate          DateTime @default(now())
  claimId           String? @unique
  claim             Claim?   @relation("ConsultationClaim", fields: [claimId], references: [id])
  createdAt         DateTime @default(now())

  prescriptions     Prescription[]
  careRecord        CareRecord?

  @@index([patientUserId])
  @@index([providerId])
}

model Prescription {
  id                String   @id @default(cuid())
  number            String   @unique
  qrToken           String   @unique
  status            String   @default("ACTIVE")
  patientUserId     String
  patientUser       User     @relation("PrescriptionPatient", fields: [patientUserId], references: [id])
  beneficiaryId     String?
  consultationId    String?
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  providerId        String
  provider          Provider @relation("PrescriptionProvider", fields: [providerId], references: [id])
  prescriberUserId  String
  prescriberUser    User     @relation("PrescriptionPrescriber", fields: [prescriberUserId], references: [id])
  prescriberName    String
  specialty         String?
  validFrom         DateTime @default(now())
  validUntil        DateTime
  renewalsAllowed   Int      @default(0)
  renewalsUsed      Int      @default(0)
  note              String?
  noteEnc           String?
  claims            Claim[]  @relation("ClaimPrescription")
  careRecord        CareRecord?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lines             PrescriptionLine[]
  deliveries        Delivery[]

  @@index([patientUserId])
  @@index([status])
}

// ═══════════════════════════════════════════
// DISTRIBUTION & COMMISSIONS
// ═══════════════════════════════════════════

model Distributor {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation("DistributorUser", fields: [userId], references: [id])
  parentDistributorId String?
  parentDistributor Distributor? @relation("DistributorHierarchy", fields: [parentDistributorId], references: [id])
  children        Distributor[] @relation("DistributorHierarchy")

  level           String    @default("AMBASSADOR")  // AMBASSADOR | COMMERCIAL | DISTRIBUTOR | INSTITUTIONAL
  territory       String?
  referralCode    String    @unique
  status          String    @default("PENDING")     // PENDING | ACTIVE | SUSPENDED

  commissionRate  Int       @default(10)            // % sur nouvelles souscriptions
  renewalRate     Int       @default(3)             // % sur renouvellements
  overrideRate    Int       @default(0)             // % override sur équipe

  totalRecruited  Int       @default(0)
  totalPremiumGenerated Int @default(0)

  referredUsers   User[]    @relation("ReferredUsers")
  contracts       Contract[]
  commissions     Commission[]
  performanceBonuses PerformanceBonus[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([referralCode])
  @@index([level])
  @@index([status])
}

model Commission {
  id              String    @id @default(cuid())
  distributorId   String
  distributor     Distributor @relation(fields: [distributorId], references: [id])
  contractId      String?
  contract        Contract?  @relation(fields: [contractId], references: [id])

  type            String                      // NEW_BUSINESS | RENEWAL | OVERRIDE | BONUS
  status          String    @default("PENDING")  // PENDING | APPROVED | PAID | REJECTED

  baseAmount      Int                          // Montant de base de la prime
  rate            Int                          // Taux de commission en %
  amount          Int                          // Montant de la commission calculée

  period          String?                      // "2026-01" pour les renouvellements
  paidAt          DateTime?
  paymentRef      String?
  note            String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([distributorId, status])
  @@index([type, status])
  @@index([period])
}

model PerformanceBonus {
  id              String    @id @default(cuid())
  distributorId   String
  distributor     Distributor @relation(fields: [distributorId], references: [id])

  period          String                      // "2026-01" or "2026-Q1"
  metric          String                      // NEW_SIGNUPS | RETENTION | ZERO_FRAUD
  target          Int
  bonusAmount     Int

  status          String    @default("PENDING")
  paidAt          DateTime?

  createdAt       DateTime  @default(now())

  @@index([distributorId, period])
}

model PrescriptionLine {
  id             String  @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String?
  medication     Medication? @relation(fields: [medicationId], references: [id])
  actId          String?
  code           String
  name           String
  categoryId     String
  quantity       Int
  unitPrice      Int
  posology       String?
  duration       String?
  instructions   String?
  deliveredQty   Int     @default(0)

  deliveryLines  DeliveryLine[]

  @@index([prescriptionId])
}

model Delivery {
  id             String   @id @default(cuid())
  reference      String   @unique
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  providerId     String
  provider       Provider @relation(fields: [providerId], references: [id])
  userId         String
  user           User     @relation("DeliveryUser", fields: [userId], references: [id])
  patientUserId  String
  patientUser    User     @relation("DeliveryPatient", fields: [patientUserId], references: [id])
  beneficiaryId  String?
  totalAmount    Int
  coveredAmount  Int
  patientAmount  Int
  claimId        String?  @unique
  claim          Claim?   @relation("DeliveryClaim", fields: [claimId], references: [id])
  careRecord     CareRecord?
  createdAt      DateTime @default(now())

  lines          DeliveryLine[]

  @@index([prescriptionId])
  @@index([providerId])
}

model DeliveryLine {
  id             String  @id @default(cuid())
  deliveryId     String
  delivery       Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lineId         String?
  line           PrescriptionLine? @relation(fields: [lineId], references: [id])
  medicationId   String?
  medication     Medication? @relation(fields: [medicationId], references: [id])
  code           String
  name           String
  categoryId     String
  quantity       Int
  unitPrice      Int
  amount         Int
  substitutionNote String?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  topic     String
  channel   String    @default("IN_APP")
  readAt    DateTime?
  meta      String?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([topic])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  ip         String?
  status     String   @default("OK")
  meta       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model RolePermission {
  id            String @id @default(cuid())
  role          String
  permissionKey String

  @@unique([role, permissionKey])
}

model SystemConfig {
  key   String @id
  value String
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model CareRecord {
  id             String   @id @default(cuid())
  reference      String   @unique
  patientUserId  String
  patientUser    User     @relation("CareRecordPatient", fields: [patientUserId], references: [id])
  beneficiaryId  String?
  beneficiary    Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id])
  consultationId String?  @unique
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  prescriptionId String?  @unique
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  deliveryId     String?  @unique
  delivery       Delivery? @relation(fields: [deliveryId], references: [id])
  claimId        String?  @unique
  claim          Claim?   @relation(fields: [claimId], references: [id])
  status         String   @default("OPEN")
  type           String   @default("GENERAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         CareRecordEvent[]

  @@index([patientUserId])
  @@index([providerId])
  @@index([status])
}

model CareRecordEvent {
  id           String     @id @default(cuid())
  careRecordId String
  careRecord   CareRecord @relation(fields: [careRecordId], references: [id], onDelete: Cascade)
  type         String
  title        String
  detail       String?
  actorUserId  String?
  actorRole    String?
  createdAt    DateTime   @default(now())

  @@index([careRecordId])
  @@index([type])
}

// ── Comptabilité technique OHADA ──
model Account {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  type      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   AccountingEntry[]
}

model Journal {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  createdAt DateTime @default(now())
  entries   AccountingEntry[]
}

model AccountingEntry {
  id            String   @id @default(cuid())
  journalId     String
  journal       Journal  @relation(fields: [journalId], references: [id])
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  date          DateTime @default(now())
  label         String
  debit         Int      @default(0)
  credit        Int      @default(0)
  referenceType String?
  referenceId   String?
  period        String?
  createdAt     DateTime @default(now())

  @@index([journalId])
  @@index([accountId])
  @@index([date])
  @@index([referenceType, referenceId])
  @@index([period])
}

// ── Référentiels Branchen / Maladies / Panier ──
model Branch {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  products    Product[]
  acts        Act[]
  createdAt   DateTime @default(now())
}

model Disease {
  id        String  @id @default(cuid())
  code      String  @unique // CIM-10
  name      String
  category  String?
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  claims    Claim[]
}
