# ══════════════════════════════════════════════════════════════════════════════
# SantéPlus Bénin — Production Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.prod and fill in the values:
#   cp .env.prod.example .env.prod
#
# NEVER commit .env.prod to git!
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=santeplus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=santeplus

# ── Security (REQUIRED) ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_96_CHAR_RANDOM_HEX_STRING
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING

# ── Application URLs ───────────────────────────────────────────────────────
WEB_ORIGIN=https://app.santeplus.bj
APP_URL=https://app.santeplus.bj

# ── Payments ───────────────────────────────────────────────────────────────
MOCK_PAYMENTS=false
PAY_PROVIDERS=FEDAPAY,CINETPAY

# FedaPay
FEDAPAY_SECRET_KEY=
FEDAPAY_MODE=live        # "sandbox" for testing, "live" for production

# CinetPay (MTN MoMo / Moov Money)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# ── S3 / Cellar (document storage) ─────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Notifications ──────────────────────────────────────────────────────────
# Comma-separated topics eligible for each channel ("none" to disable)
NOTIFY_EMAIL_TOPICS=
NOTIFY_SMS_TOPICS=

# Email (Brevo/SendGrid-compatible HTTP API)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@santeplus.bj

# SMS (generic HTTP gateway)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=SantePlus

# WhatsApp Business Cloud API (Meta) — takes priority over SMS if configured
WA_TOKEN=
WA_PHONE_ID=

# ── Let's Encrypt (TLS — self-hosted deploys) ────────────────────────────────
# Domain and email used by nginx (template var) and the certbot bootstrap step
LETSENCRYPT_DOMAIN=santeplus.bj
LETSENCRYPT_EMAIL=admin@santeplus.bj

# ── GHCR images (pull-based deploys) ─────────────────────────────────────────
# GitHub owner/org that publishes the images (e.g. "santeplus-org"). Images are
# ghcr.io/<IMAGE_OWNER>/santeplus-api and ghcr.io/<IMAGE_OWNER>/santeplus-web.
IMAGE_OWNER=
# Pin a specific tag for rollback (defaults to "latest"); the CI deploy pins the
# commit sha (full sha, no prefix).
IMAGE_TAG=latest
# Optional: credentials to pull PRIVATE GHCR packages on the server.
# Public packages can be pulled anonymously — leave blank in that case.
GHCR_USER=
GHCR_TOKEN=
