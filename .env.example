# Base de données
# Développement local (SQLite) :
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) :
# DATABASE_URL="postgresql://user:password@localhost:5432/santeplus"

# Sécurité — OBLIGATOIRE à changer en production (64+ caractères aléatoires)
JWT_SECRET="change-me-in-production"

# Clé de chiffrement des données sensibles (nationalId, motif médical, diagnostic)
# INDÉPENDANTE du JWT_SECRET — si elle change, les données chiffrées sont perdues !
# OBLIGATOIRE en production (démarrage refusé sinon) ; optionnelle en dev (fallback dérivé du JWT).
# Les payload chiffrés sont versionnés « v1. » (clé dédiée) ; les payload legacy restent lisibles.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=""

PORT=4000

# Origine(s) autorisée(s) pour le CORS, séparées par des virgules
WEB_ORIGIN="http://localhost:3000"

# URL publique de l'application (callbacks de paiement)
APP_URL="http://localhost:3000"

# Paiements
# MOCK_PAYMENTS=true autorise POST /api/payments/mock/confirm (jamais en production).
# Production PSP réel : MOCK_PAYMENTS=false et PAY_PROVIDERS=CINETPAY,FEDAPAY
MOCK_PAYMENTS="true"
PAY_PROVIDERS="MOCK_MOMO"

# FedaPay (https://fedapay.com) — activer en ajoutant le code FEDAPAY à PAY_PROVIDERS
# Callback à déclarer chez le PSP : {APP_URL}/api/payments/webhook/fedapay
# FEDAPAY_MODE=sandbox (défaut) ou live. Vérifier l'unité du champ amount sur le
# sandbox (XOF entier vs centimes) avant le passage en live.
FEDAPAY_SECRET_KEY=""
FEDAPAY_MODE="sandbox"

# CinetPay (https://cinetpay.com) — MTN MoMo / Moov Money ; code CINETPAY
# Notify URL à déclarer chez le PSP : {APP_URL}/api/payments/webhook/cinetpay
# Le succès est toujours re-vérifié via /v2/payment/check (montant inclus) —
# le webhook seul ne confirme jamais un paiement.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Notifications multi-canaux (§13)
# Sujets éligibles à chaque canal (liste séparée par des virgules) — "none" pour désactiver :
NOTIFY_EMAIL_TOPICS=""
NOTIFY_SMS_TOPICS=""
# Sans configuration, les envois sont journalisés dans la console (mode démo).
# E-mail via API HTTP compatible Brevo/SendGrid-like :
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@santeplus.bj"
# SMS via passerelle HTTP générique :
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="SantePlus"
# WhatsApp Business Cloud API (Meta) — prioritaire sur le SMS si configuré :
WA_TOKEN=""
WA_PHONE_ID=""

# Seuil global de secours pour l'autorisation préalable tiers-payant (I1) :
# éditable aussi via SystemConfig `thirdPartyAuthGlobalFallback` (admin), qui prime.
THIRD_PARTY_AUTH_GLOBAL_FALLBACK="150000"

NODE_ENV="development"
