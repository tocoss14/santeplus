generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String?
  passwordHash     String
  role             String
  status           String        @default("ACTIVE")
  firstName        String
  lastName         String
  birthDate        DateTime?
  gender           String?
  address          String?
  city             String?
  nationalIdEnc    String?
  emergencyContact String?
  memberNumber     String?       @unique
  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id])
  language         String        @default("fr")
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contractsAsPrincipal Contract[]       @relation("PrincipalContracts")
  beneficiariesAdded   Beneficiary[]    @relation("BeneficiaryCreator")
  beneficiaryChanges   BeneficiaryChange[]
  files                FileObject[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  payments             Payment[]
  claims               Claim[]          @relation("Claimant")
  claimsDecided        Claim[]          @relation("ClaimDecider")

  @@index([role])
  @@index([status])
  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String?
  taxId       String?
  address     String?
  city        String?
  phone       String?
  email       String?
  contactName String?
  status      String   @default("ACTIVE")
  claimsVisibility Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees User[]
  contracts Contract[]

  @@index([status])
}

model InsurerPartner {
  id              String  @id @default(cuid())
  name            String
  kind            String  @default("INSURER")
  agreementNumber String?
  contactEmail    String?
  phone           String?
  status          String  @default("ACTIVE")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products  Product[]
  contracts Contract[]
}

model Guarantee {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  category  String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  productGuarantees ProductGuarantee[]
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  clientType  String   @default("INDIVIDUAL")
  minAge      Int      @default(0)
  maxAge      Int      @default(65)
  beneficiaryRules     String @default("{}")
  basePremiumAnnual           Int
  pricePerAdditionalAdultAnnual Int @default(0)
  pricePerChildAnnual           Int @default(0)
  frequencyFactors     String @default("{\"ANNUAL\":1,\"QUARTERLY\":1.03,\"MONTHLY\":1.06}")
  waitingPeriodDays    Int    @default(0)
  eligibilityConditions String?
  renewalConditions     String?
  status      String   @default("DRAFT")
  sortOrder   Int      @default(0)
  insurerPartnerId String?
  insurerPartner   InsurerPartner? @relation(fields: [insurerPartnerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guarantees ProductGuarantee[]
  exclusions ProductExclusion[]
  contracts  Contract[]

  @@index([clientType, status])
}

model ProductGuarantee {
  id              String  @id @default(cuid())
  productId       String
  guaranteeId     String
  annualLimit     Int?
  rate            Int
  deductibleType  String  @default("NONE")
  deductibleValue Int     @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  guarantee Guarantee @relation(fields: [guaranteeId], references: [id])

  @@unique([productId, guaranteeId])
}

model ProductExclusion {
  id          String  @id @default(cuid())
  productId   String
  categoryId  String?
  description String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Contract {
  id       String @id @default(cuid())
  number   String @unique
  kind     String @default("INDIVIDUAL")
  status   String @default("DRAFT")
  principalUserId String
  principalUser   User   @relation("PrincipalContracts", fields: [principalUserId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  groupContractId String?
  groupContract   Contract?  @relation("GroupMembers", fields: [groupContractId], references: [id])
  members         Contract[] @relation("GroupMembers")
  insurerPartnerId String?
  insurerPartner   InsurerPartner? @relation(fields: [insurerPartnerId], references: [id])

  startDate DateTime?
  endDate   DateTime?
  premiumAnnual Int
  frequency String
  quote     String   @default("{}")
  cardToken String   @unique

  beneficiaries Beneficiary[]
  contributions Contribution[]
  claims        Claim[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([principalUserId])
  @@index([companyId])
  @@index([groupContractId])
}

model Beneficiary {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id])
  addedById    String?
  addedBy      User?     @relation("BeneficiaryCreator", fields: [addedById], references: [id])
  firstName    String
  lastName     String
  birthDate    DateTime
  gender       String
  relation     String
  memberNumber String    @unique
  status       String    @default("COVERED")
  removedAt    DateTime?

  changes BeneficiaryChange[]
  claims  Claim[]

  @@index([contractId])
}

model BeneficiaryChange {
  id            String   @id @default(cuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  action        String
  meta          String?
  byUserId      String?
  byUser        User?    @relation(fields: [byUserId], references: [id])
  createdAt     DateTime @default(now())

  @@index([beneficiaryId])
}

model Contribution {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id])
  sequence   Int
  dueDate    DateTime
  amount     Int
  status     String    @default("PENDING")
  paidAt     DateTime?
  paymentId  String?

  @@unique([contractId, sequence])
  @@index([status, dueDate])
}

model Payment {
  id          String    @id @default(cuid())
  reference   String    @unique
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Int
  method      String
  status      String    @default("PENDING")
  externalRef String?
  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  meta        String?

  @@index([status])
  @@index([userId])
}

model Claim {
  id             String    @id @default(cuid())
  reference      String    @unique
  kind           String    @default("REIMBURSEMENT")
  contractId     String
  contract       Contract  @relation(fields: [contractId], references: [id])
  claimantUserId String
  claimantUser   User      @relation("Claimant", fields: [claimantUserId], references: [id])
  beneficiaryId  String?
  beneficiary    Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id])
  providerUserId String?
  careDate       DateTime
  submittedAt    DateTime?
  status         String    @default("DRAFT")
  totalRequested Int       @default(0)
  totalApproved  Int?
  decisionNote   String?
  decidedById    String?
  decidedBy      User?     @relation("ClaimDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  paidAt         DateTime?
  paidRef        String?
  estimation     String?
  flags          String    @default("[]")

  items     ClaimItem[]
  documents ClaimDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([claimantUserId])
  @@index([contractId])
  @@index([kind, status])
}

model ClaimItem {
  id               String  @id @default(cuid())
  claimId          String
  claim            Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  guaranteeId      String?
  categoryLabel    String
  amountRequested  Int
  amountEligible   Int?
  rateApplied      Int?
  deductibleApplied Int?
  amountApproved   Int?
}

model ClaimDocument {
  id         String  @id @default(cuid())
  claimId    String
  claim      Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject @relation(fields: [fileId], references: [id])
  docType    String
  fileName   String
  mime       String
  size       Int
  sha256     String
  extracted  String?

  @@index([sha256])
}

model FileObject {
  id          String   @id @default(cuid())
  storagePath String   @unique
  mime        String
  size        Int
  sha256      String
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())

  claimDocs ClaimDocument[]

  @@index([ownerId])
}

model Provider {
  id              String  @id @default(cuid())
  name            String
  type            String
  city            String
  address         String?
  phone           String?
  email           String?
  lat             Float?
  lng             Float?
  specialties     String?
  openingHours    String?
  services        String?
  partnerStatus   String  @default("ACTIVE")
  conventionLevel String  @default("BASIC")
  thirdPartyPayer Boolean @default(false)
  notes           String?
  active          Boolean @default(true)
  createdAt       DateTime @default(now())

  claims Claim[]

  @@index([city])
  @@index([type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  topic     String
  channel   String    @default("IN_APP")
  readAt    DateTime?
  meta      String?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([topic])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  ip         String?
  status     String   @default("OK")
  meta       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model RolePermission {
  id            String @id @default(cuid())
  role          String
  permissionKey String

  @@unique([role, permissionKey])
}

model SystemConfig {
  key   String @id
  value String
}
